# Environment overrides used by `next dev` and `next start`. Committed to
# the repo intentionally. The Zoho URLs below are public form-submission
# endpoints — anyone with them can POST to the form, so add Captcha/email
# verification inside Zoho if abuse becomes an issue.
#
# Zoho Forms — public form URLs.
#
# COMPANY now uses CompanyRegistrationForm1 on the NammaOffice portal via the
# JSON /records flow (submitToZohoFormJson + uploadZohoFile). The old
# mahanacreations1 form was wrong and has been retired.
#
# All of these are the PUBLIC FORM PAGE URL (no /htmlRecords/submit suffix) —
# the route appends /records. The htmlRecords endpoint silently drops records
# that don't include Zoho's hidden auto-default fields, so we avoid it.
ZOHO_FORM_URL_COMPANY=https://forms.zohopublic.in/NammaOffice/form/CompanyRegistrationForm1/formperma/OWMv2MiXZyRbjgRsHwv7B5IxPHh-YSCXK-1BjTAmxLA
ZOHO_FORM_URL_BOOKINGS=https://forms.zohopublic.in/NammaOffice/form/NammaofficeBookings/formperma/QIa1rblKgYBCNbY_1VI0JIIpwT9z67EMNquaaJhYZ0o
ZOHO_FORM_URL_SERVICE_REQUEST=https://forms.zohopublic.in/NammaOffice/form/ServiceRequestForm/formperma/LYJsPwGr52w4V0rU-YYQu-y6UhQz0HPrNzFgJNxVvZw
# Vendor form: public form page URL (no /htmlRecords/submit suffix). Files are
# uploaded via the two-step /forms/v2/stream/publicupload + /records JSON flow.
ZOHO_FORM_URL_VENDOR=https://forms.zohopublic.in/NammaOffice/form/vendorbookingform/formperma/9ePjMkBwSw_lkRu0TAjzSz9mq4J6OMemDkGU5ke-5H0
# User registration form: public form page URL (JSON /records flow, like vendor).
ZOHO_FORM_URL_USER=https://forms.zohopublic.in/NammaOffice/form/UserRegistrationForm/formperma/_Fd-9bz74i3qoLfrMVJgK91YKfGjCSbdnJ9Lk8rthKQ

# ── Forms display mode ───────────────────────────────────────────────
# "custom" (default) = the Next.js custom-designed forms (they POST to Zoho
#   headlessly via the /api routes). "embed" = render the Zoho form itself in
#   an iframe on the page. Flip this ONE value to switch all 5 forms, then
#   restart `next dev` (or redeploy on Vercel) to apply.
FORMS_MODE=embed
# Zoho public form page URLs — used as the iframe src when FORMS_MODE=embed.
# NOTE: this CompanyRegistrationForm1 lives on the NammaOffice portal and is a
# different form from the legacy one the custom company form POSTs to (see
# ZOHO_FORM_URL_COMPANY, on the mahanacreations1 portal). So in embed mode
# company uses this form; in custom mode it still uses the legacy one.
ZOHO_EMBED_URL_COMPANY=https://forms.zohopublic.in/NammaOffice/form/CompanyRegistrationForm1/formperma/OWMv2MiXZyRbjgRsHwv7B5IxPHh-YSCXK-1BjTAmxLA
ZOHO_EMBED_URL_USER=https://forms.zohopublic.in/NammaOffice/form/UserRegistrationForm/formperma/_Fd-9bz74i3qoLfrMVJgK91YKfGjCSbdnJ9Lk8rthKQ
ZOHO_EMBED_URL_VENDOR=https://forms.zohopublic.in/NammaOffice/form/vendorbookingform/formperma/9ePjMkBwSw_lkRu0TAjzSz9mq4J6OMemDkGU5ke-5H0
ZOHO_EMBED_URL_BOOKINGS=https://forms.zohopublic.in/NammaOffice/form/NammaofficeBookings/formperma/QIa1rblKgYBCNbY_1VI0JIIpwT9z67EMNquaaJhYZ0o
ZOHO_EMBED_URL_SERVICE_REQUEST=https://forms.zohopublic.in/NammaOffice/form/ServiceRequestForm/formperma/LYJsPwGr52w4V0rU-YYQu-y6UhQz0HPrNzFgJNxVvZw

# Google Analytics 4 — Measurement ID for the NammaOffice web stream.
# Consumed by components/analytics/GoogleAnalytics.tsx (renders gtag.js).
# NEXT_PUBLIC_* is inlined at build time and ships to the browser (not secret).
# Must also be set in Vercel (Production + Preview) — Vercel ignores .env.local.
NEXT_PUBLIC_GA_ID=G-7P125TY1PC

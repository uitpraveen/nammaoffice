# Keep real values outside Git. Use: docker compose --env-file /secure/cms.env ...
# Use a randomly generated URL-safe password here (e.g. 48 hex characters).
POSTGRES_PASSWORD=
BETTER_AUTH_URL=https://your-staging-domain.example
BETTER_AUTH_SECRET=
CMS_BOOTSTRAP_EMAIL=
# Start in local mode until email delivery has been explicitly configured.
CMS_MAIL_MODE=local
CMS_MAIL_FROM=
RESEND_API_KEY=
# Native backup scripts need the DATABASE_URL and CMS_DATA_DIR of their target,
# plus a 32-byte base64 CMS_BACKUP_KEY. Keep this key and BETTER_AUTH_SECRET
# in an encrypted off-server secret store. See docs/vps-cms.md.
CMS_BACKUP_KEY=

# Optional Google sign-in. Invite each staff email before first login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace accounts: exact company domain; do not use gmail.com or '*'.
CMS_GOOGLE_WORKSPACE_DOMAIN=
# Consumer Gmail: comma-separated exact approved email addresses.
CMS_ALLOWED_EMAILS=

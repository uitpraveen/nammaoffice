# Set in Vercel Project Settings > Environment Variables before deploying.
# Keep all credentials server-only; never use NEXT_PUBLIC_ names.
ADMIN_PASSWORD=replace-with-a-long-random-team-password
ADMIN_SESSION_SECRET=replace-with-an-independent-random-secret
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-the-database-read-write-token
BLOB_READ_WRITE_TOKEN=keep-your-existing-blob-token
BLOB_MANIFEST_URL=https://your-store.public.blob.vercel-storage.com/clients/manifest.json

# Optional: normally omit. Vercel defaults to separate production/preview namespaces.
# A custom namespace must differ between environments and stay stable after import.
# CMS_NAMESPACE=nammaoffice:production

# Local development writes .cms/content.json and public/images/cms by default.
# To deliberately test a separate cloud database locally, set CMS_DRIVER=redis.
# Never point local tests at the production namespace or store.
